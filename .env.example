# ==============================================================================
# FleetFlow Environment Configuration Template (.env.example)
# Copy this file to `.env` (`cp .env.example .env`) and fill in your GCP project.
# Zero personal accounts, API keys, or project IDs are hardcoded in the repo.
# ==============================================================================

# 1. Core Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# 2. BigQuery Enterprise Order Book & Telemetry Dataset
#    Populated via: uv run python scripts/publish_demo_data.py
FLEETFLOW_BQ_DATASET=fleetflow_demo
LOADPILOT_BQ_DATASET=fleetflow_demo

# 3. Cloud Storage Bucket for 3D Loader Videos, Driver Portals & Dock Photos
#    Defaults to <GOOGLE_CLOUD_PROJECT>-fleetflow-media if left blank
FLEETFLOW_MEDIA_BUCKET=
LOADPILOT_PUBLISH_MEDIA=true

# 4. Google Maps Platform / Routing Engine
#    Uses Google Routes API (computeRoutes) when ADC/Maps API is enabled;
#    automatically falls back to OSRM road geometry if unset.
LOADPILOT_ROUTER=auto
GOOGLE_MAPS_API_KEY=

# 5. Optional: Gemini Enterprise Registration Target
GE_APP_ID=
GE_APP_LOCATION=global
VIEWER_DOMAIN=

# 6. Optional: Custom Authorized User / Service Account ADC File Path
FLEETFLOW_ADC_FILE=
